{
  "mechanism": "../USCMechII.yaml",
  "device": "auto",
  "output_dir": "results_ch4_corrected_Srow",
  "sensitivity": {"rate_law": "corrected", "substep_tol": 0.01, "max_substeps": 64, "progress_every": 0},
  "aggregation": {"abs_S": true, "normalization": "S_row_sum"},
  "idt": {
    "enabled": true,
    "source": "solver",
    "solver": {
      "fuel": {"CH4": 1.0}, "oxidizer": {"O2": 0.21, "N2": 0.79},
      "T_K": [1200.0, 1400.0, 1600.0], "P_atm": [1.0, 10.0], "phi": [0.5, 1.0],
      "reactor": "constant_volume", "end_time_s": 0.05, "reference_species": "OH"
    }
  },
  "fs": {
    "enabled": true,
    "source": "solver",
    "solver": {
      "fuel": {"CH4": 1.0}, "oxidizer": {"O2": 0.21, "N2": 0.79},
      "T_unburnt_K": 300.0, "P_atm": [1.0], "phi": [0.8, 1.0, 1.2], "domain_width_m": 0.03
    }
  },
  "ranking": {"target_species": ["CH4", "O2", "OH", "H2O", "CO2"], "combine": "hybrid"},
  "reduction": {"step": 1, "min_species": 15, "error_tolerance": 0.05}
}
